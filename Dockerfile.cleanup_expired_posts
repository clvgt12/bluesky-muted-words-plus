# Dockerfile.cleanup-job
FROM python:3.12-slim-bookworm

# Set application environment
# Suppress interactive prompts during apt-get install
ENV DEBIAN_FRONTEND=noninteractive 
ENV PYTHONUNBUFFERED=1
# Keep APP_HOME as /app for consistency with previous setup
ENV APP_HOME=/home/appuser 
ENV NLTK_DATA=${APP_HOME}/nltk_data
# SPACY_MODEL_DIR is used during download, SPACY_DATA for runtime lookup if needed.
# Let spaCy install models into site-packages, which is common with PyTorch base images.
# Removed SPACY_MODEL_DIR as a distinct environment variable for simplicity.
ENV PYTHONPATH=${APP_HOME}
ENV PATH="/home/appuser/.local/bin:${PATH}" 
# Copy huggingface offline model cache
ENV HF_HUB_OFFLINE=1
ENV HF_HOME=${APP_HOME}/.cache/huggingface
# Set FLASK_ENV to development for local Minikube testing
ENV FLASK_ENV=development

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    locales \
    locales-all \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Configure locale to ensure consistent text processing
RUN locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN adduser --disabled-password --gecos "" appuser
WORKDIR ${APP_HOME}
RUN chown appuser:appuser ${APP_HOME}
USER appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download NLTK + SpaCy models
# SpaCy models will install into Python's site-packages when using 'download -q'.
# Ensure the NLTK_DATA directory is created and owned by appuser.
RUN mkdir -p ${NLTK_DATA} && \
    python -m nltk.downloader -d ${NLTK_DATA} wordnet punkt stopwords && \
    python -m spacy download en_core_web_sm -q 
    
COPY . ${APP_HOME}

# Command to run the cleanup job
CMD ["python", "server/cleanup_expired_posts.py"]